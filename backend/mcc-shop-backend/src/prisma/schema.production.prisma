// Production Prisma schema for MCC Shop App
// Use this schema on Vercel with a hosted PostgreSQL DATABASE_URL.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  name           String
  email          String?   @unique
  phone          String    @unique
  password       String
  role           String    @default("CUSTOMER")
  savedAddresses String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders         Order[]
  rider          Rider?
}

model Product {
  id            String       @id @default(uuid())
  skuCode       String       @unique
  name          String
  brand         String?
  category      String
  subCategory   String?
  unitSize      String
  costPrice     Float
  sellingPrice  Float
  vatIncluded   Boolean      @default(true)
  bulkThreshold Int          @default(0)
  bulkPrice     Float?
  stockQty      Int          @default(0)
  lowStockAlert Int          @default(5)
  dispatchMode  String       @default("BIKE")
  isFragile     Boolean      @default(false)
  isHazardous   Boolean      @default(false)
  images        String?
  notes         String?
  isPublished   Boolean      @default(false)
  mvpPriority   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orderItems    OrderItem[]
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          String      @default("PENDING")
  deliveryAddress String
  deliveryLat     Float?
  deliveryLng     Float?
  vehicleType     String
  deliveryFee     Float       @default(0)
  subtotal        Float
  total           Float
  notes           String?
  scheduledAt     DateTime?
  riderId         String?
  rider           Rider?      @relation(fields: [riderId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
  payment         Payment?
  dispatchLog     DispatchLog?
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Float
  totalPrice Float
}

model Payment {
  id         String        @id @default(uuid())
  orderId    String        @unique
  order      Order         @relation(fields: [orderId], references: [id])
  method     String
  status     String        @default("PENDING")
  amount     Float
  reference  String?       @unique
  momoPhone  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Rider {
  id          String      @id @default(uuid())
  userId      String      @unique
  user        User        @relation(fields: [userId], references: [id])
  status      String      @default("OFFLINE")
  currentLat  Float?
  currentLng  Float?
  totalTrips  Int         @default(0)
  earnings    Float       @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  orders       Order[]
  dispatchLogs DispatchLog[]
}

model DispatchLog {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id])
  riderId       String
  rider         Rider    @relation(fields: [riderId], references: [id])
  proofPhotoUrl String?
  signatureUrl  String?
  deliveredAt   DateTime?
  createdAt     DateTime @default(now())
}
