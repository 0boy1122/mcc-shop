# Local SQLite:
DATABASE_URL="file:./dev.db"

# Production Postgres on Vercel/Supabase/Neon:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
JWT_SECRET="replace_with_a_long_random_secret"
JWT_EXPIRES_IN="7d"

PORT=5000
NODE_ENV=development

CLIENT_URL="http://localhost:3000"

# Staff login. Use ADMIN_PASSWORD/RIDER_PASSWORD for separate credentials,
# or STAFF_PASSWORD as one shared fallback.
STAFF_PASSWORD="replace_me"
ADMIN_PASSWORD=""
RIDER_PASSWORD=""

# Vercel Blob enables durable product image uploads in production.
BLOB_READ_WRITE_TOKEN=""

# Optional payment and AI integrations.
GEMINI_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYSTACK_SECRET_KEY=""
